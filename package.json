{
  "name": "eleventy-base-blog",
  "version": "5.0.2",
  "description": "A starter repository for a blog web site using the Eleventy static site generator.",
  "scripts": {
    "build": "npm run css && eleventy",
    "start": "concurrently \"eleventy --serve\" \"npm run css:watch\"",
    "watch": "eleventy --watch",
    "serve": "eleventy --serve",
    "debug": "DEBUG=* eleventy",
    "css": "tailwindcss -i resources/css/style.css -o css/style.css --minify",
    "css:watch": "tailwindcss -i resources/css/style.css -o css/style.css --watch",
    "export:videos": "node scripts/export-videos.js"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/11ty/eleventy-base-blog.git"
  },
  "author": {
    "name": "Zach Leatherman",
    "email": "zachleatherman@gmail.com",
    "url": "https://zachleat.com/"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/11ty/eleventy-base-blog/issues"
  },
  "homepage": "https://github.com/11ty/eleventy-base-blog#readme",
  "devDependencies": {
    "@11ty/eleventy": "^0.11.0",
    "@11ty/eleventy-navigation": "^0.1.3",
    "@11ty/eleventy-plugin-rss": "^1.0.7",
    "@11ty/eleventy-plugin-syntaxhighlight": "^3.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "luxon": "^1.21.3",
    "markdown-it": "^8.4.2",
    "markdown-it-anchor": "^5.2.5",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "@11ty/eleventy-cache-assets": "^2.2.1",
    "@11ty/eleventy-img": "^0.9.0",
    "concurrently": "^5.3.0",
    "dotenv": "^8.2.0",
    "mongoose": "^5.10.14",
    "slugify": "^1.4.6",
    "xml2js": "^0.4.23"
  },
  "engines": {
    "node": ">=24"
  }
}
