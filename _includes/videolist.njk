<ul class="space-y-12 sm:grid sm:grid-cols-2 sm:gap-x-6 sm:gap-y-12 sm:space-y-0 lg:grid-cols-4 lg:gap-x-8">
{% for video in videolist %}
  <li>
    <a href="{{ video.url | url }}" class="space-y-4">
      {% image video.data.thumbnail, "shadow-lg rounded-lg", video.data.title %}

      <div class="space-y-2">
        <div class="text-lg leading-6 font-medium">
          <h4>{{ video.data.title }}</h4>
          <time class="text-tertiary-600" datetime="{{ video.date | htmlDateString }}">{{ video.date | readableDate }}</time>
        </div>
      </div>
    </a>
  </li>
{% endfor %}
</ul>
