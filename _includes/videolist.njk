<ul class="space-y-12 sm:grid sm:grid-cols-2 sm:gap-x-6 sm:gap-y-12 sm:space-y-0 lg:grid-cols-4 lg:gap-x-8">
{% for video in videolist %}
  <li>
    <a href="/videos/{{ video.permalink | url }}" class="space-y-4">
      {% if video.upcoming %}
      {% image "/img/upcoming.jpg", "shadow-lg rounded-lg", video.title %}
      {% else %}
      {% image video.thumbnail.medium.url, "shadow-lg rounded-lg", video.title %}
      {% endif %}

      <div class="space-y-2">
        <div class="text-lg leading-6 font-medium space-y-1">
          <h4>{{ video.title }}</h4>
          <time class="text-tertiary-600" datetime="{{ video.published | htmlDateString }}">{{ video.published | readableDate }}</time>
        </div>
      </div>
    </a>
  </li>
{% endfor %}
</ul>
