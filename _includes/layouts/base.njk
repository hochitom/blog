          <nav class="hidden md:flex space-x-10">
            {%- for entry in collections.all | eleventyNavigation %}
            <a
              href="{{ entry.url | url }}"
              class="text-base leading-6 hover:text-gray-900 focus:outline-none focus:text-gray-900 transition ease-in-out duration-150 {% if entry.url == page.url %}text-gray-900 font-bold{% else %}text-gray-500 font-medium{% endif %}"
            >
              {{ entry.title }}
            </a>
            {%- endfor %}
          </nav>
        </div>
      </div>
    </div>

    <main>
      {{ content | safe }}
    </main>

