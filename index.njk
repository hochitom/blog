---
layout: layouts/home.njk
eleventyNavigation:
  key: Home
  order: 1
---

{# TODO: get latest blog video #}
{% set latestVideo = collections.videos | latestVlog %}
<div class="relative py-16 bg-tertiary-900 text-white overflow-hidden">
    <div class="relative px-4 sm:px-6 lg:px-8 max-w-screen-xl mx-auto">
        <div class="relative mb-6" style="padding-bottom: 56%">
            <iframe class="w-full absolute" style="height: 100%" src="https://www.youtube-nocookie.com/embed/{{ latestVideo.id }}" frameborder="0" allowfullscreen></iframe>
        </div>
        <div class="text-lg max-w-prose mx-auto mb-6">
            <h1 class="mt-2 mb-8 text-3xl text-center leading-8 font-extrabold tracking-tight text-gray-900 sm:text-4xl sm:leading-10">{{ latestVideo.title }}</h1>
        </div>
    </div>
</div>

<div class="bg-white">
  <div class="mx-auto py-12 px-4 max-w-screen-xl sm:px-6 lg:px-8 lg:py-24">
    <div class="space-y-12">
      <div class="space-y-5 sm:space-y-4 md:max-w-xl lg:max-w-3xl xl:max-w-none">
        <h2 class="text-3xl leading-9 font-extrabold tracking-tight sm:text-4xl">Aktuelle Videos</h2>
      </div>

      {% set videolist = collections.videos | excludeHeroVideo(latestVideo.id) | head(4) %}
      {% include "videolist.njk" %}
    </div>
  </div>

  <div class="mx-auto py-12 px-4 max-w-screen-xl sm:px-6 lg:px-8 lg:py-24">
    <div class="space-y-12">
      <div class="space-y-5 sm:space-y-4 md:max-w-xl lg:max-w-3xl xl:max-w-none">
        <h2 class="text-3xl leading-9 font-extrabold tracking-tight sm:text-4xl">Beliebte Videos</h2>
      </div>

      {% set videolist = collections.videos | popularVideos | head(4) %}
      {% include "videolist.njk" %}
    </div>
  </div>
</div>

<div class="relative py-16 bg-white overflow-hidden">
    <div class="relative px-4 sm:px-6 lg:px-8">
        <div class="text-lg max-w-prose mx-auto mb-6">
            <h1 class="mt-2 mb-8 text-3xl text-center leading-8 font-extrabold tracking-tight text-gray-900 sm:text-4xl sm:leading-10">Aktuelle Blogartikel</h1>
        </div>
        <div class="prose prose-lg text-gray-500 mx-auto">
            {% set postslist = collections.posts | head(-5) %}
            {% set postslistCounter = collections.posts | length %}
            {% include "postslist.njk" %}
            <p>Mehr Artikel gibts im <a href="{{ '/posts/' | url }}">Archiv</a>.</p>
        </div>
    </div>
</div>
