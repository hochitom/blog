---
import type { CollectionEntry } from 'astro:content'
import Base from './Base.astro'
import ContentSection from '../components/ContentSection.astro'
import VideoEmbed from '../components/VideoEmbed.astro'
import VideoSection from '../components/VideoSection.astro'
import { getVideos } from '../lib/content'

interface Props {
  video: CollectionEntry<'videos'>
}

const { video } = Astro.props
const popular = (await getVideos())
  .filter(v => v.id !== video.id)
  .sort((a, b) => b.data.viewCount - a.data.viewCount)
  .slice(0, 8)
---

<Base title={video.data.title}>
  <ContentSection title={video.data.title} wide>
    <VideoEmbed
      slot="before"
      id={video.data.id}
      title={video.data.title}
      thumbnail={video.data.thumbnail}
    />

    <slot />
    <p><a href={video.data.link}>Video auf YouTube anschauen</a></p>
  </ContentSection>

  <VideoSection title="Beliebte Videos" videos={popular} slider />
</Base>
