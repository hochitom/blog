---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { site } from '../lib/site'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
}

const { title = site.title, description = site.description } = Astro.props
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2b2d42" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link
      rel="alternate"
      href="/feed/feed.xml"
      type="application/rss+xml"
      title={site.title}
    />
    <script is:inline src="/sw.js"></script>
  </head>

  <body>
    <a href="#inhalt" class="skip-link">Zum Inhalt springen</a>

    <Header />

    <main id="inhalt">
      <slot />
    </main>

    <Footer />

    <script>
      // Zwei-Klick-Einbettung: Der Drittanbieter-iframe wird erst nach dem Klick geladen.
      document.addEventListener('click', event => {
        const button = (event.target as Element).closest('.consent-embed__button')
        const box = button?.closest<HTMLElement>('[data-consent-embed]')
        if (!button || !box?.dataset.src) return

        const iframe = document.createElement('iframe')
        iframe.src = box.dataset.src
        iframe.title = box.dataset.title ?? ''
        iframe.allowFullscreen = true
        iframe.referrerPolicy = 'no-referrer-when-downgrade'
        box.replaceChildren(iframe)
        iframe.focus()
      })
    </script>
  </body>
</html>
