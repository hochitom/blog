---
import Base from './Base.astro'

interface Props {
  title: string
  // Frontmatter-Layout: Astro übergibt das Frontmatter als frontmatter-Prop
  frontmatter?: { title: string }
}

const title = Astro.props.frontmatter?.title ?? Astro.props.title
---

<Base title={title}>
  <div class="relative py-16 bg-white overflow-hidden">
    <div class="relative px-4 sm:px-6 lg:px-8">
      <div class="text-lg max-w-prose mx-auto mb-6">
        <h1 class="mt-2 mb-8 text-3xl text-center leading-8 font-extrabold tracking-tight text-gray-900 sm:text-4xl sm:leading-10">{title}</h1>
      </div>
      <div class="prose prose-lg text-gray-500 mx-auto">
        <slot />
        <p><a href="/">← Home</a></p>
      </div>
    </div>
  </div>
</Base>
