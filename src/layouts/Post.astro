---
import type { CollectionEntry } from 'astro:content'
import Base from './Base.astro'
import { getTagList } from '../lib/content'

interface Props {
  post: CollectionEntry<'posts'>
}

const { post } = Astro.props
const tagList = await getTagList()
---

<Base title={post.data.title}>
  <div class="relative py-16 bg-white overflow-hidden">
    <div class="relative px-4 sm:px-6 lg:px-8">
      <div class="text-lg max-w-prose mx-auto mb-6">
        {
          post.data.tags
            .filter(tag => tagList.includes(tag))
            .map(tag => (
              <a
                href={`/tags/${tag}/`}
                class="text-base text-center leading-6 text-indigo-600 font-semibold tracking-wide uppercase"
              >
                {tag}
              </a>
            ))
            .flatMap(link => [link, ' '])
        }

        <h1 class="mt-2 mb-8 text-3xl text-center leading-8 font-extrabold tracking-tight text-gray-900 sm:text-4xl sm:leading-10">{post.data.title}</h1>
      </div>
      <div class="prose prose-lg text-gray-500 mx-auto">
        <slot />
        <p><a href="/">← Home</a></p>
      </div>
    </div>
  </div>
</Base>
