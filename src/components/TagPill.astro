---
interface Props {
  tag: string
  count?: number
}

const { tag, count } = Astro.props
---

<a href={`/tags/${tag}/`} class="tag-pill">
  {tag}
  {count !== undefined && <span class="tag-pill__count">{count}</span>}
</a>

<style>
  .tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--color-tertiary-900);
    color: var(--color-tertiary-900);
    font-size: 0.9375rem;
    line-height: 1.25rem;
    font-weight: 500;
    transition: background-color 0.15s ease-in-out, color 0.15s ease-in-out;
  }

  .tag-pill:hover {
    background-color: var(--color-tertiary-900);
    color: var(--color-white);
  }

  .tag-pill__count {
    font-family: var(--font-display);
    font-weight: 700;
  }
</style>
