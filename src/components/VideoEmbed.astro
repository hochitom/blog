---
interface Props {
  id: string
  title: string
}

const { id, title } = Astro.props
---

<div class="embed">
  <iframe
    src={`https://www.youtube-nocookie.com/embed/${id}`}
    title={title}
    allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
    allowfullscreen></iframe>
</div>

<style>
  /* 16:9 */
  .embed {
    position: relative;
    margin-bottom: 1.5rem;
    padding-bottom: 56%;
  }

  iframe {
    position: absolute;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
