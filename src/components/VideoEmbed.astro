---
interface Props {
  id: string
  title: string
  // Player ohne src ausliefern, ein Skript setzt ihn (ohne JavaScript greift <noscript>)
  deferred?: boolean
}

const { id, title, deferred = false } = Astro.props
const src = `https://www.youtube-nocookie.com/embed/${id}`
---

<div class="embed">
  <iframe
    src={deferred ? undefined : src}
    title={title}
    allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
    allowfullscreen></iframe>
  {
    deferred && (
      <noscript>
        <iframe src={src} title={title} allowfullscreen />
      </noscript>
    )
  }
</div>

<style>
  /* 16:9 */
  .embed {
    position: relative;
    margin-bottom: 1.5rem;
    padding-bottom: 56%;
  }

  iframe {
    position: absolute;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
