---
import { Picture } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import { htmlDateString, readableDate } from '../lib/dates'

interface Props {
  videos: CollectionEntry<'videos'>[]
}

const { videos } = Astro.props
---

<ul class="video-list">
  {
    videos.map(video => (
      <li>
        <a href={`/videos/${video.id}/`} class="video-card">
          <Picture
            src={video.data.thumbnail}
            formats={['webp']}
            fallbackFormat="jpeg"
            class="video-card__image"
            alt={video.data.title}
          />

          <div class="video-card__title">
            <time
              class="video-card__date"
              datetime={htmlDateString(video.data.date)}
            >
              {readableDate(video.data.date)}
            </time>
            <h4>{video.data.title}</h4>
          </div>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .video-list {
    display: grid;
    gap: 3rem;
  }

  .video-card {
    display: block;
  }

  /* <picture> und das Bild darin: Astro reicht die Klasse an das <img> weiter */
  .video-card :global(picture) {
    margin-bottom: 1rem;
  }

  .video-card__image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .video-card__title h4 {
    margin-top: 0.25rem;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
    transition: color 0.15s ease-in-out;
  }

  .video-card:hover .video-card__title h4 {
    color: var(--color-primary-900);
  }

  .video-card__date {
    display: block;
    margin-top: 0.25rem;
    color: var(--color-tertiary-700);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  @media (min-width: 40rem) {
    .video-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1.5rem;
    }
  }

  @media (min-width: 64rem) {
    .video-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: 2rem;
    }
  }
</style>
