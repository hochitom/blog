---
import { Picture } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import { htmlDateString, readableDate } from '../lib/dates'

interface Props {
  videos: CollectionEntry<'videos'>[]
  // horizontaler Slider mit Snapping statt Raster
  slider?: boolean
}

const { videos, slider = false } = Astro.props
---

<ul
  class:list={['video-list', { 'video-list--slider': slider }]}
  tabindex={slider ? 0 : undefined}
  aria-label={slider ? 'Videos, horizontal scrollbar' : undefined}
>
  {
    videos.map(video => (
      <li>
        <a href={`/videos/${video.id}/`} class="video-card">
          <Picture
            src={video.data.thumbnail}
            formats={['webp']}
            fallbackFormat="jpeg"
            class="video-card__image"
            alt={video.data.title}
          />

          <div class="video-card__title">
            <time
              class="video-card__date"
              datetime={htmlDateString(video.data.date)}
            >
              {readableDate(video.data.date)}
            </time>
            <h4>{video.data.title}</h4>
          </div>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .video-list {
    display: grid;
    gap: 3rem;
  }

  .video-card {
    display: block;
  }

  /* <picture> und das Bild darin: Astro reicht die Klasse an das <img> weiter */
  .video-card :global(picture) {
    margin-bottom: 1rem;
  }

  .video-card__image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .video-card__title h4 {
    margin-top: 0.25rem;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
    transition: color 0.15s ease-in-out;
  }

  .video-card:hover .video-card__title h4 {
    color: var(--color-primary-900);
  }

  .video-card__date {
    display: block;
    margin-top: 0.25rem;
    color: var(--color-tertiary-700);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* Slider: CSS Scroll Snap, Karten zeigen jeweils die nächste angeschnitten */
  .video-list--slider {
    display: flex;
    gap: 1.5rem;
    margin-inline: -1rem;
    padding: 0 1rem 1.5rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 1rem;
    scrollbar-color: var(--color-tertiary-900) var(--color-line);
  }

  .video-list--slider > li {
    flex: 0 0 82%;
    scroll-snap-align: start;
  }

  @media (min-width: 40rem) {
    .video-list--slider {
      margin-inline: -1.5rem;
      padding-inline: 1.5rem;
      scroll-padding-inline: 1.5rem;
    }

    .video-list--slider > li {
      flex-basis: calc((100% - 1.5rem * 2) / 2.5);
    }
  }

  @media (min-width: 64rem) {
    .video-list--slider {
      margin-inline: 0;
      padding-inline: 0;
      scroll-padding-inline: 0;
      gap: 2rem;
    }

    .video-list--slider > li {
      flex-basis: calc((100% - 2rem * 3) / 4);
    }
  }

  @media (min-width: 40rem) {
    .video-list:not(.video-list--slider) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1.5rem;
    }
  }

  @media (min-width: 64rem) {
    .video-list:not(.video-list--slider) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: 2rem;
    }
  }
</style>
