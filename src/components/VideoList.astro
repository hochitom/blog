---
import { Picture } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import { htmlDateString, readableDate } from '../lib/dates'

interface Props {
  videos: CollectionEntry<'videos'>[]
}

const { videos } = Astro.props
---

<ul class="space-y-12 sm:grid sm:grid-cols-2 sm:gap-x-6 sm:gap-y-12 sm:space-y-0 lg:grid-cols-4 lg:gap-x-8">
  {
    videos.map(video => (
      <li>
        <a href={`/videos/${video.id}/`} class="space-y-4">
          <Picture
            src={video.data.thumbnail}
            formats={['webp']}
            fallbackFormat="jpeg"
            class="w-full shadow-lg rounded-lg"
            alt={video.data.title}
          />

          <div class="space-y-2">
            <div class="text-lg leading-6 font-medium">
              <h4>{video.data.title}</h4>
              <time
                class="text-tertiary-600"
                datetime={htmlDateString(video.data.date)}
              >
                {readableDate(video.data.date)}
              </time>
            </div>
          </div>
        </a>
      </li>
    ))
  }
</ul>
