---
import { getTopTags } from '../lib/content'

const topics = await getTopTags(4)
---

<section class="topics">
  <div class="topics__inner">
    <h2 class="topics__title display">Themen</h2>
    <ul class="topics__grid">
      {
        topics.map(({ tag, count }) => (
          <li>
            <a href={`/tags/${tag}/`} class="topic">
              <span class="topic__name display">{tag}</span>
              <span class="topic__meta eyebrow">
                {count} Artikel →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="topics__all"><a href="/tags/">Alle Themen</a></p>
  </div>
</section>

<style>
  .topics {
    --focus-color: var(--color-white);
    background-color: var(--color-tertiary-900);
    color: var(--color-white);
  }

  .topics__inner {
    max-width: var(--width-content);
    margin-inline: auto;
    padding: 3rem 1rem;
  }

  .topics__title {
    margin-bottom: 2rem;
    font-size: 2.5rem;
  }

  .topics__grid {
    display: grid;
    gap: 2px;
    background-color: var(--color-ink-deep);
  }

  .topic {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    min-height: 8.5rem;
    padding: 1.5rem;
    background-color: var(--color-tertiary-900);
    transition: background-color 0.15s ease-in-out;
  }

  .topic:hover {
    background-color: var(--color-primary-900);
  }

  .topic__name {
    font-size: 2.5rem;
  }

  .topic__meta {
    color: var(--color-accent-900);
    transition: color 0.15s ease-in-out;
  }

  .topic:hover .topic__meta {
    color: var(--color-white);
  }

  .topics__all {
    margin-top: 1.5rem;
    font-weight: 600;
  }

  .topics__all a {
    border-bottom: 2px solid var(--color-accent-900);
  }

  @media (min-width: 40rem) {
    .topics__inner {
      padding-inline: 1.5rem;
    }

    .topics__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .topics__inner {
      padding: 4.5rem 2rem;
    }

    .topics__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
