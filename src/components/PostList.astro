---
import type { CollectionEntry } from 'astro:content'
import { htmlDateString } from '../lib/dates'

interface Props {
  // neueste zuerst
  posts: CollectionEntry<'posts'>[]
}

const { posts } = Astro.props
---

<ul class="post-list">
  {
    posts.map(post => (
      <li class="post-list__item">
        <a href={`/posts/${post.id}/`} class="post-row">
          <time class="post-row__year eyebrow" datetime={htmlDateString(post.data.date)}>
            {post.data.date.getFullYear()}
          </time>
          <span class="post-row__text">
            {post.data.tags.length > 0 && (
              <span class="post-row__tags eyebrow">{post.data.tags.join(' · ')}</span>
            )}
            <span class="post-row__title display">{post.data.title}</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .post-list {
    border-bottom: 1px solid var(--color-line);
  }

  .post-row {
    display: flex;
    gap: 1.25rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--color-line);
  }

  .post-row__year {
    flex: none;
    width: 3.5rem;
    color: var(--color-tertiary-700);
  }

  .post-row__text {
    flex: 1;
    min-width: 0;
  }

  .post-row__tags {
    display: block;
    color: var(--color-primary-950);
    font-size: 0.875rem;
  }

  .post-row__title {
    display: block;
    margin-top: 0.25rem;
    color: var(--color-tertiary-900);
    font-size: 1.875rem;
    line-height: 1;
    transition: color 0.15s ease-in-out;
  }

  .post-row:hover .post-row__title {
    color: var(--color-primary-900);
  }
</style>
