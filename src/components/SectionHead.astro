---
interface Props {
  title: string
  // optionaler Link rechts, z. B. „Alle Videos“
  href?: string
  linkText?: string
}

const { title, href, linkText } = Astro.props
---

<div class="section-head">
  <div class="section-head__main">
    <h2 class="section-head__title display">{title}</h2>
    <slot />
  </div>
  {href && <a href={href} class="section-head__link">{linkText} →</a>}
</div>

<style>
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 2rem;
    padding-bottom: 0.75rem;
    border-bottom: 3px solid var(--color-tertiary-900);
  }

  .section-head__main {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 2rem;
  }

  .section-head__title {
    color: var(--color-tertiary-900);
    font-size: 2.5rem;
  }

  .section-head__link {
    font-weight: 600;
    transition: color 0.15s ease-in-out;
  }

  .section-head__link:hover {
    color: var(--color-primary-900);
  }
</style>
