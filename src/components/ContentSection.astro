---
interface Props {
  title: string
  // schmaler Text oder breite Fläche (z. B. mit Video)
  wide?: boolean
  // dunkler Hintergrund, z. B. für das Video auf der Startseite
  dark?: boolean
}

const { title, wide = false, dark = false } = Astro.props
const hasBody = Astro.slots.has('default')
---

<div class:list={['section', { 'section--dark': dark }]}>
  <div class:list={['section__inner', { 'section__inner--wide': wide }]}>
    <slot name="before" />

    <div class="section__header">
      <slot name="meta" />
      <h1 class="section__title">{title}</h1>
    </div>

    {
      hasBody && (
        <div class="prose prose-lg section__body">
          <slot />
        </div>
      )
    }
  </div>
</div>

<style>
  .section {
    position: relative;
    overflow: hidden;
    padding-block: 4rem;
    background-color: var(--color-paper);
  }

  .section--dark {
    background-color: var(--color-ink-deep);
    color: var(--color-white);
  }

  .section__inner {
    position: relative;
    padding-inline: 1rem;
  }

  .section__inner--wide {
    max-width: var(--width-content);
    margin-inline: auto;
  }

  .section__header {
    max-width: var(--width-prose);
    margin-inline: auto;
    margin-bottom: 2rem;
  }

  .section__inner--wide .section__header {
    max-width: none;
  }

  .section__title {
    margin-top: 0.75rem;
    color: var(--color-tertiary-900);
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 800;
    line-height: 0.95;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .section--dark .section__title {
    color: var(--color-white);
  }

  .section__body {
    margin-inline: auto;
  }

  @media (min-width: 40rem) {
    .section__inner {
      padding-inline: 1.5rem;
    }
  }

  @media (min-width: 64rem) {
    .section {
      padding-block: 5rem;
    }

    .section__inner {
      padding-inline: 2rem;
    }
  }
</style>
