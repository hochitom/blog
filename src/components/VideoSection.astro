---
import type { CollectionEntry } from 'astro:content'
import VideoList from './VideoList.astro'
import SectionHead from './SectionHead.astro'

interface Props {
  title: string
  videos: CollectionEntry<'videos'>[]
  // horizontaler Slider statt Raster
  slider?: boolean
  // Link „Alle Videos“ anzeigen
  showAll?: boolean
}

const { title, videos, slider = false, showAll = true } = Astro.props
---

<div class="video-section">
  <div class="video-section__inner">
    <SectionHead
      title={title}
      href={showAll ? '/videos/' : undefined}
      linkText="Alle Videos"
    />
    <VideoList videos={videos} slider={slider} />
  </div>
</div>

<style>
  .video-section {
    background-color: var(--color-white);
  }

  .video-section__inner {
    max-width: var(--width-content);
    margin-inline: auto;
    padding: 3rem 1rem;
  }

  @media (min-width: 40rem) {
    .video-section__inner {
      padding-inline: 1.5rem;
    }
  }

  @media (min-width: 64rem) {
    .video-section__inner {
      padding: 5rem 2rem;
    }
  }
</style>
