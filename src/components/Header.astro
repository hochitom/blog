---
import Logo from './Logo.astro'
import { navigation } from '../lib/navigation'

const current = Astro.url.pathname

// Unterseiten (z. B. ein Artikel) markieren ihren Bereich als aktuell
const isCurrent = (url: string) =>
  url === '/' ? current === '/' : current.startsWith(url)
---

<div class="site-header">
  <div class="site-header__inner">
    <div class="site-header__bar">
      <div class="site-header__brand">
        <a href="/" aria-label="hochitom.at">
          <Logo />
        </a>
      </div>

      <button
        type="button"
        class="nav-toggle js-toggle-nav"
        aria-label="Navigation"
        aria-expanded="false"
      >
        <svg
          class="nav-toggle__icon"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"
          />
        </svg>
      </button>

      <nav class="nav js-nav">
        {navigation.map((entry) => (
          <a
            href={entry.url}
            class="nav__link"
              aria-current={isCurrent(entry.url) ? 'page' : undefined}
          >
            {entry.title}
          </a>
        ))}
      </nav>
    </div>
  </div>
</div>

<style>
  .site-header {
    --focus-color: var(--color-white);
    position: relative;
    background-color: var(--color-tertiary-900);
    color: var(--color-white);
  }

  .site-header__inner {
    max-width: var(--width-content);
    margin-inline: auto;
    padding-inline: 1rem;
  }

  .site-header__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 1.5rem;
  }

  .site-header__brand {
    flex: 1;
    width: 0;
  }

  .nav-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-right: -0.5rem;
    padding: 0.5rem;
    border-radius: var(--radius-md);
    color: var(--color-accent-600);
    cursor: pointer;
    transition: background-color 0.15s ease-in-out, color 0.15s ease-in-out;
  }

  .nav-toggle:hover,
  .nav-toggle[aria-expanded='true'] {
    background-color: var(--color-tertiary-800);
    color: var(--color-white);
  }

  .nav-toggle__icon {
    width: 1.5rem;
    height: 1.5rem;
  }

  /* mobil: ausklappbares Menü direkt unter der Kopfzeile */
  .nav {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 10;
    padding-block: 0.5rem;
    border-top: 1px solid var(--color-tertiary-700);
    background-color: var(--color-tertiary-900);
    box-shadow: var(--shadow-lg);
  }

  .nav:global(.is-open) {
    display: block;
  }

  .nav__link {
    display: block;
    padding: 0.75rem 1rem;
    border-bottom: 3px solid transparent;
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.5rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: border-color 0.15s ease-in-out;
  }

  .nav__link:hover,
  .nav__link[aria-current='page'] {
    border-bottom-color: var(--color-primary-900);
  }

  @media (min-width: 40rem) {
    .site-header__inner {
      padding-inline: 1.5rem;
    }

    .nav__link {
      padding-inline: 1.5rem;
    }
  }

  @media (min-width: 48rem) {
    .site-header__bar {
      justify-content: flex-start;
      gap: 2.5rem;
    }

    .nav-toggle {
      display: none;
    }

    .nav {
      display: flex;
      position: static;
      gap: 2.5rem;
      padding: 0;
      border: 0;
      background-color: transparent;
      box-shadow: none;
    }

    .nav__link {
      display: inline;
      padding: 0.5rem 0;
    }

  }
</style>

<script>
  const button = document.querySelector('.js-toggle-nav')
  const nav = document.querySelector('.js-nav')

  button?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open') ?? false
    button.setAttribute('aria-expanded', String(open))
  })
</script>
