---
import Base from '../../layouts/Base.astro'
import ContentSection from '../../components/ContentSection.astro'
import PostList from '../../components/PostList.astro'
import { getPosts, getTagList } from '../../lib/content'

export async function getStaticPaths() {
  const [posts, tags] = await Promise.all([getPosts(), getTagList()])
  return tags.map(tag => ({
    params: { tag },
    props: { tag, posts: posts.filter(post => post.data.tags.includes(tag)) },
  }))
}

const { tag, posts } = Astro.props
const title = `Artikel zu „${tag}“`
---

<Base title={title}>
  <ContentSection title={title}>
    <PostList posts={posts} />
    <p><a href="/tags/">Alle Tags ansehen</a></p>
  </ContentSection>
</Base>
