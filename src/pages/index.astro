---
import Base from '../layouts/Base.astro'
import ContentSection from '../components/ContentSection.astro'
import VideoEmbed from '../components/VideoEmbed.astro'
import VideoSection from '../components/VideoSection.astro'
import PostList from '../components/PostList.astro'
import { getPosts, getVideos } from '../lib/content'

const videos = await getVideos()
const posts = await getPosts()

const latestVideo = videos[0]
const latestVideos = videos.filter(v => v.data.id !== latestVideo.data.id).slice(0, 4)
const popularVideos = [...videos]
  .sort((a, b) => b.data.viewCount - a.data.viewCount)
  .slice(0, 4)
const latestPosts = posts.slice(0, 5)
---

<Base>
  <ContentSection title={latestVideo.data.title} wide dark>
    <VideoEmbed slot="before" id={latestVideo.data.id} title={latestVideo.data.title} />
  </ContentSection>

  <VideoSection title="Aktuelle Videos" videos={latestVideos} />
  <VideoSection title="Beliebte Videos" videos={popularVideos} />

  <ContentSection title="Aktuelle Blogartikel">
    <PostList posts={latestPosts} total={posts.length} />
    <p>Mehr Artikel gibts im <a href="/posts/">Archiv</a>.</p>
  </ContentSection>
</Base>
